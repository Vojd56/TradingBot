# Provozní režim bota: backtest | paper | live (výchozí bezpečný je paper)
TRADING_MODE=paper

# Tvrdý bezpečnostní zámek pro LIVE režim (pouze 'true' odemkne reálné peníze)
CONFIRM_LIVE_TRADING=false
I_UNDERSTAND_LIVE_RISK=no

# Trading 212 API klíč
TRADING_212_DEMO_API_KEY=your_trading_212_api_key_here

# Lokální LLM (Lemonade Server na AMD NPU)
LEMONADE_BASE_URL=http://localhost:13305/api/v1
LEMONADE_API_KEY=lemonade
LEMONADE_MODEL=Qwen2.5-7B-Instruct-NPU

# Parametry kapitálu
INITIAL_CAPITAL_EUR=50000.0
MAX_POSITIONS=15

# Financial Modeling Prep (FMP) API klíč (volitelné)
FMP_API_KEY=your_fmp_api_key_here
